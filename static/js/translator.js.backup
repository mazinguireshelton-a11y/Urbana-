                'Ver Relatório': 'View Report',
                'Exportar CSV': 'Export CSV',
                'Exportar PDF': 'Export PDF',
                'Deletar': 'Delete',
                'Nenhuma simulação encontrada': 'No simulations found',
                
                // Simulation Form
                'Nome da Área': 'Area Name',
