                'Sucesso': 'Success',
                'Aviso': 'Warning',
                'Informação': 'Information',
                'Carregando': 'Loading',
                'Salvando': 'Saving',
                'Enviando': 'Sending',
                'Confirmar': 'Confirm',
                'Cancelar': 'Cancel',
                'Sim': 'Yes',
                'Não': 'No',
                'OK': 'OK',
                
                // Themes
                'Tema Claro': 'Light Theme',
                'Tema Escuro': 'Dark Theme',
                'Tema Automático': 'Auto Theme',
                'Alternar Tema': 'Toggle Theme',
                
                // Charts
                'Água (L/dia)': 'Water (L/day)',
                'Energia (kWh/dia)': 'Energy (kWh/day)',
                'Consumo por Localidade': 'Consumption by Location',
                'Tendência de Consumo': 'Consumption Trend',
                'Distribuição por Tipo': 'Distribution by Type',
                
                // Footer
                'URBANA - Sistema de Planejamento Urbano': 'URBANA - Urban Planning System',
                'Todos os direitos reservados': 'All rights reserved',
                'Termos de Uso': 'Terms of Use',
                'Política de Privacidade': 'Privacy Policy',
                
                // Authentication
                'Esqueci minha senha': 'Forgot Password',
                'Lembrar-me': 'Remember Me',
                'Confirmar Senha': 'Confirm Password',
                'Reenviar Confirmação': 'Resend Confirmation',
                'Login com Google': 'Login with Google',
                'Email de confirmação enviado': 'Confirmation email sent',
                
                // Placeholders
                'Digite seu nome': 'Enter your name',
                'Digite seu email': 'Enter your email',
                'Digite sua senha': 'Enter your password',
                'Digite o nome da área': 'Enter area name',
                'Digite a população': 'Enter population',
                'Digite o tamanho da área': 'Enter area size',
                'Selecione o tipo de construção': 'Select building type'
            }
        };

        window.urbanaTranslatorInstance = this;
        this.init();
    }

    init() {
        // Verificar se já foi inicializado
        if (this.initialized) return;
        
        // Carregar linguagem salva
        this.loadLanguage();
        
        // Adicionar botão de tradução ao header
        this.addLanguageToggle();
        
        // Observar mudanças no DOM
        this.observeDOM();
        
        this.initialized = true;
    }

    getSavedLanguage() {
        return localStorage.getItem('urbana_lang') || 
               document.documentElement.lang || 
               (navigator.language.startsWith('en') ? 'en : 'pt');
    }

    saveLanguage(lang) {
        localStorage.setItem('urbana_lang', lang);
        this.currentLang = lang;
        document.documentElement.lang = lang;
    }

    addLanguageToggle() {
        // Remover todos os language-toggle existentes
        const existingToggles = document.querySelectorAll('#language-toggle, .language-toggle');
        existingToggles.forEach(toggle => toggle.remove());
        
        // Procurar elementos apropriados para adicionar o seletor
        const navUser = document.querySelector('.nav-user, .user-info, .auth-links');
        const navLinks = document.querySelector('.nav-links');
        const mainHeader = document.querySelector('.main-header .container');
        
        let targetElement = navUser || navLinks || mainHeader || document.body;
        
        // Se já existir um seletor de idioma na navbar, remover
        const existingNavSelect = targetElement.querySelector('.language-selector');
        if (existingNavSelect) {
            existingNavSelect.remove();
        }
        
        const languageToggle = document.createElement('div');
        languageToggle.id = 'language-toggle';
        languageToggle.className = 'language-toggle';
        languageToggle.innerHTML = `
            <button class="lang-btn ${this.currentLang === 'pt' ? 'active' : ''}" data-lang="pt" title="Português">
                🇧🇷 PT
            </button>
            <button class="lang-btn ${this.currentLang === 'en' ? 'active' : ''}" data-lang="en" title="English">
                🇺🇸 EN
            </button>
        `;
        
        // Estilos inline para garantir visibilidade
        languageToggle.style.cssText = `
            display: flex;
            gap: 5px;
            margin: 0 10px;
        `;

        if (navUser) {
            navUser.insertBefore(languageToggle, navUser.firstChild);
        } else if (navLinks) {
            navLinks.parentNode.insertBefore(languageToggle, navLinks.nextSibling);
        } else {
            document.body.insertBefore(languageToggle, document.body.firstChild);
            
            // Estilo para posicionamento flutuante
            languageToggle.style.position = 'fixed';
            languageToggle.style.top = '10px';
            languageToggle.style.right = '10px';
            languageToggle.style.zIndex = '9999';
            languageToggle.style.background = 'white';
            languageToggle.style.padding = '5px 8px';
            languageToggle.style.borderRadius = '5px';
            languageToggle.style.boxShadow = '0 2px 10px rgba(0,0,0,0.2)';
        }

        // Adicionar eventos aos botões
        languageToggle.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const lang = e.target.dataset.lang;
                this.switchLanguage(lang);
            });
        });
    }

    switchLanguage(lang) {
        if (lang === this.currentLang) return;
        
        this.saveLanguage(lang);
        this.translatePage();
        
        // Atualizar botões ativos
        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.classList.remove('active');
            if (btn.dataset.lang === lang) {
                btn.classList.add('active');
            }
        });
        
        // Atualizar seletor na navbar se existir
        const navSelect = document.querySelector('#language-select');
        if (navSelect) {
            navSelect.value = lang;
        }
        
        // Notificação visual
        this.showLanguageNotification(lang);
    }

    translatePage() {
        // Traduzir todos os elementos de texto
        this.translateElements(document.body);
        
        // Atualizar meta tags
        this.updateMetaTags();
        
        // Atualizar footer theme info
        this.updateThemeInfo();
    }

    translateElements(element) {
        // Percorrer todos os nós de texto
        const walker = document.createTreeWalker(
            element,
            NodeFilter.SHOW_TEXT,
            {
                acceptNode: function(node) {
                    // Ignorar nós vazios ou que contenham apenas espaços
                    if (!node.nodeValue.trim()) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    
                    // Ignorar elementos dentro de script, style, code, etc.
                    const parent = node.parentElement;
                    if (parent && 
                        (parent.tagName === 'SCRIPT' || 
                         parent.tagName === 'STYLE' ||
                         parent.tagName === 'CODE' ||
                         parent.tagName === 'PRE' ||
                         parent.classList.contains('no-translate'))) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    
                    // Ignorar elementos dentro do language-toggle
                    if (parent && (parent.id === 'language-toggle' || parent.classList.contains('language-toggle'))) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    
                    return NodeFilter.FILTER_ACCEPT;
                }
            }
        );

        const nodes = [];
        let node;
        while (node = walker.nextNode()) {
            nodes.push(node);
        }

        // Traduzir cada nó
        nodes.forEach(node => {
            const originalText = node.nodeValue.trim();
            const translation = this.translations[this.currentLang][originalText];
            
            if (translation && translation !== originalText) {
                node.nodeValue = node.nodeValue.replace(originalText, translation);
            }
        });

        // Traduzir atributos específicos
        this.translateAttributes(element);
    }

    translateAttributes(element) {
        // Placeholders
        element.querySelectorAll('[placeholder]').forEach(el => {
            const original = el.getAttribute('placeholder');
            const translation = this.translations[this.currentLang][original];
            if (translation) {
                el.setAttribute('placeholder', translation);
            }
        });

        // Títulos
        element.querySelectorAll('[title]').forEach(el => {
            const original = el.getAttribute('title');
            const translation = this.translations[this.currentLang][original];
            if (translation) {
                el.setAttribute('title', translation);
            }
        });

        // Labels
        element.querySelectorAll('label').forEach(el => {
            if (el.textContent.trim()) {
                const original = el.textContent.trim();
                const translation = this.translations[this.currentLang][original];
                if (translation) {
                    el.textContent = translation;
                }
            }
        });

        // Alt text
        element.querySelectorAll('[alt]').forEach(el => {
            const original = el.getAttribute('alt');
            const translation = this.translations[this.currentLang][original];
            if (translation) {
                el.setAttribute('alt', translation);
            }
        });
        
        // Option texts
        element.querySelectorAll('option').forEach(el => {
            if (el.textContent.trim()) {
                const original = el.textContent.trim();
                const translation = this.translations[this.currentLang][original];
                if (translation) {
                    el.textContent = translation;
                }
            }
        });
    }

    updateMetaTags() {
        // Atualizar título da página
        const titleElement = document.querySelector('title');
        if (titleElement) {
            const original = titleElement.textContent;
            const parts = original.split(' | ');
            if (parts.length > 1) {
                const translation = this.translations[this.currentLang][parts[1]];
                if (translation) {
                    titleElement.textContent = `${parts[0]} | ${translation}`;
                }
            }
        }
    }

    updateThemeInfo() {
        const themeSpan = document.getElementById('current-theme');
        if (themeSpan) {
            const original = themeSpan.textContent;
            const translation = this.translations[this.currentLang][original];
            if (translation) {
                themeSpan.textContent = translation;
            }
        }
    }

    loadLanguage() {
        if (this.currentLang !== 'pt') {
            this.translatePage();
        }
    }

    observeDOM() {
        // Observar mudanças no DOM para conteúdo dinâmico
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.addedNodes.length) {
                    mutation.addedNodes.forEach((node) => {
                        if (node.nodeType === 1) { // Element node
                            this.translateElements(node);
                        }
                    });
                }
            });
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    }

    showLanguageNotification(lang) {
        // Remover notificação existente
        const existing = document.querySelector('.language-notification');
        if (existing) existing.remove();

        const messages = {
            'pt': 'Idioma alterado para Português',
            'en': 'Language changed to English'
        };

        const notification = document.createElement('div');
        notification.className = 'language-notification';
        notification.textContent = messages[lang];
        
        // Estilos
        notification.style.cssText = `
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #1565C0;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            z-index: 10000;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            animation: slideIn 0.3s ease-out;
        `;

        document.body.appendChild(notification);

        // Remover após 3 segundos
        setTimeout(() => {
            notification.style.animation = 'slideOut 0.3s ease-out';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }

    // Método para adicionar traduções dinamicamente
    addTranslation(key, ptText, enText) {
        if (!this.translations.pt[key]) {
            this.translations.pt[key] = ptText;
        }
        if (!this.translations.en[key]) {
            this.translations.en[key] = enText;
        }
    }

    // Método para traduzir texto específico
    translateText(text) {
        return this.translations[this.currentLang][text] || text;
    }
}

// Inicializar apenas se ainda não foi inicializado
document.addEventListener('DOMContentLoaded', () => {
    if (!window.urbanaTranslator) {
        window.urbanaTranslator = new UrbanaTranslator();
        
        // Adicionar estilos CSS para o tradutor
        const style = document.createElement('style');
        style.textContent = `
            .language-toggle {
                display: flex;
                gap: 5px;
                margin: 0 10px;
            }
            
            .lang-btn {
                background: none;
                border: 1px solid #ddd;
                border-radius: 4px;
                padding: 5px 10px;
                cursor: pointer;
                font-size: 0.85rem;
                transition: all 0.2s;
                font-family: 'Inter', sans-serif;
            }
            
            .lang-btn:hover {
                background: #f0f0f0;
            }
            
            .lang-btn.active {
                background: #1565C0;
                color: white;
                border-color: #1565C0;
                font-weight: 500;
            }
            
            @keyframes slideIn {
                from {
                    transform: translateX(100%);
                    opacity: 0;
                }
                to {
                    transform: translateX(0);
                    opacity: 1;
                }
            }
            
            @keyframes slideOut {
                from {
                    transform: translateX(0);
                    opacity: 1;
                }
                to {
                    transform: translateX(100%);
                    opacity: 0;
                }
            }
            
            /* Para conteúdo que não deve ser traduzido */
            .no-translate {
                font-style: italic;
                opacity: 0.8;
            }
        `;
        document.head.appendChild(style);
    }
});

// Exportar para uso global
if (typeof module !== 'undefined' && module.exports) {
    module.exports = UrbanaTranslator;
}
