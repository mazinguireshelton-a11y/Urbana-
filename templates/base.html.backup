<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}URBANA{% endblock %}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/theme.css') }}">
</head>

<body class="light-theme">
    <!-- 1. HEADER COM IDENTIDADE -->
    <header class="main-header">
        <div class="container">
            <h1>URBANA</h1>
            <p class="subtitle">Sistema Inteligente de Planejamento de Infraestrutura Urbana</p>
        </div>
    </header>

    <!-- 2. NAVBAR FUNCIONAL COM SELETOR DE TEMA -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="nav-brand">
                <span class="nav-logo">🏙️</span>
                <span class="nav-title">URBANA</span>
            </div>
            
            <ul class="nav-links">
                <li><a href="/" class="nav-link {% if request.endpoint == 'index' %}active{% endif %}">🏠 Início</a></li>
                <li><a href="/dashboard" class="nav-link {% if request.endpoint == 'dashboard' %}active{% endif %}">📊 Dashboard</a></li>
                <li><a href="/my-simulations" class="nav-link {% if request.endpoint == 'my_simulations' %}active{% endif %}">📋 Simulações</a></li>
                <li><a href="/profile" class="nav-link {% if request.endpoint == 'profile' %}active{% endif %}">👤 Perfil</a></li>
            </ul>
            
            <div class="nav-user">
                {% if current_user.is_authenticated %}
                    <div class="user-info">

                        <!-- Seletor de Tema -->
                        <div class="theme-toggle">
                            <button class="theme-btn light-btn" onclick="setTheme('light')" title="Tema Claro">
                                ☀️
                            </button>
                            <button class="theme-btn dark-btn" onclick="setTheme('dark')" title="Tema Escuro">
                                🌙
                            </button>
                            <button class="theme-btn auto-btn" onclick="setTheme('auto')" title="Auto (Sistema)">
                                🔄
                            </button>
                        </div>
                        
                        <span class="user-name">{{ current_user.name.split()[0] }}</span>
                        <a href="/logout" class="btn btn-sm btn-outline">Sair</a>
                    </div>
                {% else %}
                    <div class="auth-links">

                        <a href="/login" class="btn btn-sm btn-outline">Entrar</a>
                        <a href="/register" class="btn btn-sm btn-primary">Cadastrar</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </nav>

    <!-- 3. CONTEÚDO PRINCIPAL -->
    <main class="main-content">
        <div class="container">
            {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}
                    {% for category, message in messages %}
                        <div class="alert alert-{{ category }} fade-in-up">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endif %}
            {% endwith %}
            
            {% block content %}{% endblock %}
        </div>
    </main>

    <!-- 4. FOOTER -->
    <footer class="main-footer">
        <div class="container">
            <p class="footer-text">© 2026 • Projeto URBANA • Engenharia & Impacto Social</p>
            <div class="theme-info">
                <small>Tema atual: <span id="current-theme">Claro</span></small>
            </div>
        </div>
    </footer>

    <script src="{{ url_for('static', filename='js/main.js') }}"></script>
    <script src="{{ url_for('static', filename='js/theme.js') }}"></script>
    <script src="{{ url_for('static', filename='js/translator.js') }}"></script>
</body>
</html>
